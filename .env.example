# ======================================================================
# JangAI — Modele de configuration
#
# Copiez ce fichier en `.env` et renseignez vos valeurs :
#     cp .env.example .env
# Le vrai `.env` est ignore par git : il ne doit JAMAIS etre committe.
# ======================================================================

# --- LLM (API compatible OpenAI) --------------------------------------
# UN SEUL endroit pour choisir le modele. L'app parle l'API OpenAI standard :
# Groq, vLLM, Ollama, LM Studio, ou votre propre modele deploye fonctionnent.
# Laisser ces 3 vides => repli sur les parametres GROQ_* ci-dessous.
#   Groq            : LLM_BASE_URL=https://api.groq.com/openai/v1
#   vLLM (local)    : LLM_BASE_URL=http://localhost:8000/v1
#   Ollama (local)  : LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500

# --- LLM : parametres Groq (defaut / repli) ---------------------------
# Cle a generer sur https://console.groq.com (ne la partagez jamais).
GROQ_API_KEY=
# Modeles disponibles : openai/gpt-oss-120b, qwen/qwen3.8-27b, groq/compound
GROQ_MODEL=openai/gpt-oss-120b

# --- PostgreSQL -------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432            # 5433 si le port 5432 est deja pris
POSTGRES_DB=jangai
POSTGRES_USER=jangai
POSTGRES_PASSWORD=change_me

# --- Embedding + Reranking --------------------------------------------
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_BATCH_SIZE=16
# Device des modeles : "cuda" si un GPU est disponible, sinon "cpu".
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# --- Decoupage (HybridChunker) ---------------------------------------
CHUNK_MAX_TOKENS=512

# --- Extraction des tableaux -----------------------------------------
# auto : Docling s'il est installe ET si un tableau est detecte au pre-scan ;
#        PyMuPDF sinon. docling | pymupdf pour forcer.
TABLE_BACKEND=auto
DOCLING_OCR=false

# --- OCR (Tesseract) --------------------------------------------------
# Chemin complet vers l'executable Tesseract (pas seulement le dossier).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=fra+eng

# --- Transcription vocale (STT, /transcribe) --------------------------
# faster-whisper en LOCAL (open-source, aucune donnee ne sort de la machine).
# Modeles : large-v3 (meilleure qualite) | medium | small | base.
STT_MODEL=large-v3
# Device : auto (cuda si dispo) | cuda | cpu.
STT_DEVICE=auto
# float16 (GPU, qualite) | int8_float16 (GPU, + leger) | int8 (CPU).
STT_COMPUTE_TYPE=float16
# Langue forcee (ex. "fr"). Vide = detection automatique.
STT_LANGUAGE=fr
# true pour precharger le modele vocal au demarrage du serveur.
WARMUP_STT=false

# --- Divers -----------------------------------------------------------
LOG_LEVEL=INFO
